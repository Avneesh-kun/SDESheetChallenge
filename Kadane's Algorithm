class Solution {
    public int maxSubArray(int[] nums) {
        int sum = 0;
        int maxi = Integer.MIN_VALUE;

        //taking a loop for entire array
        for(int i =0; i<nums.length; i++){
            sum = sum + nums[i];

            //checking maxi and sum
            if(sum > maxi){
                maxi = sum;
            }
            if(sum<0){
                sum = 0;
            }
        }
        return maxi;
    }
}
